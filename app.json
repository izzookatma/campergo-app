{
  "expo": {
    "name": "NaturaGo",
    "slug": "campergo-app",
    "scheme": "naturago",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a00761bf-354c-44cc-853b-5a06a22ffed4"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "it.naturago.app",
      "appleTeamId": "S534G29VQB",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.naturago.it",
        "applinks:naturago.it"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usiamo la tua posizione per mostrarti le strutture più vicine a te.",
        "NSPhotoLibraryUsageDescription": "Per aggiungere foto ai tuoi annunci del mercatino e alla vetrina della tua struttura.",
        "NSCameraUsageDescription": "Per scattare le foto della tua struttura e caricarle nella vetrina.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "it.naturago.app",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBSsjGE-cPNnsy1iGNqzk5RlQmXqMkMWcQ"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#00587C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.naturago.it"
            },
            {
              "scheme": "https",
              "host": "naturago.it"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usiamo la tua posizione per mostrarti le strutture più vicine a te."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Per aggiungere foto ai tuoi annunci del mercatino e alla vetrina della tua struttura.",
          "cameraPermission": "Per scattare le foto della tua struttura e caricarle nella vetrina."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00587C"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NaturaGo usa il microfono per dettare a voce la ricerca o il percorso da creare, invece di scriverlo.",
          "speechRecognitionPermission": "NaturaGo trascrive quello che dici per capire cosa stai cercando o che percorso vuoi creare."
        }
      ],
      "expo-web-browser",
      "expo-status-bar",
      "expo-image",
      "expo-localization"
    ],
    "extra": {
      "mappaAndroidAttiva": true,
      "eas": {
        "projectId": "a00761bf-354c-44cc-853b-5a06a22ffed4"
      }
    },
    "owner": "naturago"
